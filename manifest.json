{
  "manifest_version": 3,
  "name": "小飞猪的书签",
  "version": "3.0.0",
  "description": "A beautiful tree view of your bookmarks on the new tab page with advanced customization and management.",
  "permissions": [
    "bookmarks",
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "favicon",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.google.com/",
    "*://*.google.com/*",
    "*://*.google.com.hk/*",
    "*://*.google.co.jp/*",
    "https://*.gstatic.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.googleapis.com/*",
    "*://chatgpt.com/*",
    "*://*.chatgpt.com/*",
    "*://*.openai.com/*",
    "*://chat.qwen.ai/*",
    "*://*.chat.qwen.ai/*",
    "*://*.doubao.com/*",
    "*://kimi.moonshot.cn/*",
    "*://*.kimi.moonshot.cn/*",
    "*://*.deepseek.com/*",
    "*://*.gemini.google.com/*",
    "*://claude.ai/*",
    "*://*.claude.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "remove_xframe",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
