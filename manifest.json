{
  "manifest_version": 3,
  "name": "小飞猪的书签",
  "version": "1.0.4",
  "description": "A beautiful tree view of your bookmarks on the new tab page.",
  "permissions": [
    "bookmarks",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "*://*.chatgpt.com/*",
    "*://chatgpt.com/*",
    "*://*.grok.com/*",
    "*://grok.com/*",
    "*://*.qwen.ai/*",
    "*://qwen.ai/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "remove_xframe",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}