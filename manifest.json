{
  "manifest_version": 3,
  "name": "小飞猪的书签",
  "version": "0.3.1",
  "description": "A beautiful tree view of your bookmarks on the new tab page.",
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}